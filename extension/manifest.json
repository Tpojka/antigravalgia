{
  "manifest_version": 3,
  "name": "Antigravalgia",
  "version": "1.0.0",
  "description": "Toolbar lower back that hurts while Antigravity CLI is working and relaxes when Antigravity is ready.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Antigravalgia: connecting\u2026",
    "default_icon": {
      "16": "icons/back-unknown-16.png",
      "32": "icons/back-unknown-32.png",
      "48": "icons/back-unknown-48.png",
      "128": "icons/back-unknown-128.png"
    }
  },
  "icons": {
    "16": "icons/back-ok-16.png",
    "32": "icons/back-ok-32.png",
    "48": "icons/back-ok-48.png",
    "128": "icons/back-ok-128.png"
  }
}
